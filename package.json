{
  "name": "covercraft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "cd worker && wrangler dev",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test worker/index.test.js && node --experimental-strip-types --test test/demo.test.js",
    "preview": "vite preview",
    "deploy:worker": "cd worker && wrangler deploy",
    "secret:worker": "cd worker && wrangler secret put OPENAI_API_KEY"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.72.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.164.0"
  }
}
