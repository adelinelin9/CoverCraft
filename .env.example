# Copy this file to .env.local for local development.
# This is the Worker URL, not an API key. Never put GEMINI_API_KEY in a VITE_ variable.
VITE_WORKER_URL=http://localhost:8787

# For production, set VITE_WORKER_URL to your deployed Worker URL instead.
# Example: https://covercraft-worker.YOUR-ACCOUNT.workers.dev
